{
  "version": 2,
  "builds": [
    {
      "src": "web/app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "web/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "web/app.py"
    }
  ],
  "env": {
    "AWARDLINE_SECRET": "@awardline-secret",
    "GROQ_API_KEY": "@groq-api-key",
    "GROQ_MODEL": "llama-3.1-70b-versatile"
  }
}
